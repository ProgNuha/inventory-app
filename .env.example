# OPSIONAL. Bila dikosongkan / file .env tidak ada, APP_KEY dibuat otomatis saat container start.
# Isi agar key tetap sama setelah container dibuat ulang:
#   cd backend && php artisan key:generate --show
APP_KEY=

# OPSIONAL. Password database PostgreSQL untuk Docker lokal (default: admin).
# Ubah sebelum pertama kali `docker compose up`; bila sudah terlanjur dibuat, jalankan `docker compose down -v` dulu.
# DB_PASSWORD=admin
